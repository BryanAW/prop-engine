# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# API Keys (Phase 1+)
# API-Basketball from RapidAPI - https://rapidapi.com/api-sports/api/api-basketball
# Free tier: 100 requests/day
API_BASKETBALL_KEY=your_rapidapi_key_here
API_BASKETBALL_HOST=api-basketball-v1.p.rapidapi.com

# The Odds API - https://the-odds-api.com/
# Free tier: 500 requests/month
ODDS_API_KEY=your_odds_api_key_here

# Feature Flags
USE_EXTERNAL_APIS=false
CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
